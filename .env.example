# Database
DATABASE_URL=postgresql+psycopg://verdict:verdict_dev@localhost:5432/verdict
POSTGRES_USER=verdict
POSTGRES_PASSWORD=verdict_dev
POSTGRES_DB=verdict
POSTGRES_PORT=5432

# Security & Auth
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# LLM Providers (comma-separated keys)
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
OLLAMA_BASE_URL=http://localhost:11434

# Tier Chains
CHAIN_STRONG=
CHAIN_MID=
CHAIN_SMALL=

# Embeddings & Reranking
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Server Settings
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

